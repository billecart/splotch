{
  "name": "splotch",
  "productName": "splotch",
  "version": "0.16.1",
  "description": "An editor for ink",
  "main": "main-process/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billecart/splotch.git"
  },
  "scripts": {
    "postinstall": "node ../build/createDocumentnavigation.js && markdown-html resources/Documentation/WritingWithInk.md -s resources/Documentation/documentation.css -o renderer/documentation/embedded.html",
    "start": "electron main-process/main.js",
    "test": "node --test test/*.test.js",
    "generate-locale": "node ../build/generateLocale.js",
    "build-package": "node build-package.js"
  },
  "keywords": [
    "ink",
    "narrative",
    "editor"
  ],
  "author": "billecart",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/billecart/splotch/issues"
  },
  "homepage": "https://github.com/billecart/splotch",
  "dependencies": {
    "chokidar": "^3.6.0",
    "fuzzaldrin-plus": "^0.6.0",
    "inkjs": "^2.2.3",
    "lodash": "^4.17.21",
    "mkdirp": "^3.0.1",
    "randomstring": "^1.3.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.2",
    "electron": "^30.0.4",
    "markdown-html": "^0.0.8"
  },
  "optionalDependencies": {
    "appdmg": "^0.6.6"
  },
  "allowScripts": {
    "electron@30.0.4": true,
    "fs-xattr@0.3.1": true,
    "fsevents@2.3.3": true,
    "macos-alias@0.2.11": true
  }
}
